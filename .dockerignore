# Ignore everything by default
**

# Allow only what Docker builds need
!backend/**
!docker/**
!nginx/**
!frontend/**

# Re-ignore common junk inside allowed dirs
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/htmlcov/
**/staticfiles/
**/media/
**/*.sqlite
**/*.sqlite3
**/*.db
**/node_modules/
**/.vite/
**/dist/
**/build/
**/*.egg-info/
**/.DS_Store
**/*.log
**/*.tmp
**/*.swp
**/.env
**/.env.*
