# Ignore everything by default
**

# Allow only what Docker builds need
!backend/**
!docker/**
!nginx/**
!frontend/**
!infra/**

# Re-ignore common junk inside allowed dirs
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.hypothesis/
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/htmlcov/
**/staticfiles/
**/media/
**/*.sqlite
**/*.sqlite3
**/*.db
**/node_modules/
**/.next/
**/coverage/
**/*.tsbuildinfo
**/.npm/
**/.yarn/
**/.pnpm-store/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.vite/
**/dist/
**/build/
**/*.egg-info/
**/.DS_Store
**/*.log
**/*.tmp
**/*.swp
**/.env
**/.env.*
