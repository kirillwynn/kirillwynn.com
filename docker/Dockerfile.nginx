# docker/Dockerfile.nginx
# Immutable nginx image:
# - builds frontend (Vite) in CI inside this Docker build
# - bakes dist into /usr/share/nginx/html
# - bakes nginx vhost config into /etc/nginx/conf.d

FROM node:20-alpine AS frontend_builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:stable

COPY nginx/conf.d/ /etc/nginx/conf.d/
COPY --from=frontend_builder /app/frontend/dist/ /usr/share/nginx/html/

# Keep if you need it; otherwise you can remove this line entirely.
COPY nginx/docker-entrypoint.d/ /docker-entrypoint.d/

EXPOSE 80 443