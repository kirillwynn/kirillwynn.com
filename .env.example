# Local Django/PostgreSQL development only. Copy to .env and change as needed.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
DJANGO_ADMIN_URL=django-admin/
WAGTAIL_ADMIN_BASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_PREVIEW_URL=http://localhost:3000/api/draft
PREVIEW_TOKEN_TTL_SECONDS=600

# Generate at least 32 UTF-8 bytes locally; never commit the runtime value.
REVALIDATION_URL=http://localhost:3000/api/revalidate
REVALIDATION_SECRET=
REVALIDATION_TIMEOUT_SECONDS=5
REVALIDATION_TIMESTAMP_WINDOW_SECONDS=300
REVALIDATION_PROCESSING_TIMEOUT_SECONDS=300

# Email remains local/in-memory until an environment explicitly selects Resend.
# Generate signing secrets outside Git and keep them at least 32 UTF-8 bytes.
EMAIL_PROVIDER_ADAPTER=apps.subscriptions.providers.memory.MemoryEmailProvider
EMAIL_PROVIDER_IDEMPOTENCY_NAMESPACE=local/test
EMAIL_FROM_ADDRESS=Kirill Wynn <posts@kirillwynn.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SUBSCRIPTION_SIGNING_SECRET=
SUBSCRIPTION_TOKEN_TTL_SECONDS=172800
SUBSCRIPTION_CONFIRMATION_COOLDOWN_SECONDS=900
SUBSCRIPTION_RATE_LIMIT_COUNT=5
SUBSCRIPTION_RATE_LIMIT_WINDOW_SECONDS=3600
SUBSCRIPTION_CONFIRM_RATE_LIMIT_COUNT=20
SUBSCRIPTION_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=3600
EMAIL_OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
EMAIL_OUTBOX_MAX_ATTEMPTS=8
EMAIL_OUTBOX_RETRY_BASE_SECONDS=30
EMAIL_OUTBOX_RETRY_MAX_SECONDS=21600
EMAIL_DELIVERY_BATCH_SIZE=100
EMAIL_PROVIDER_TIMEOUT_SECONDS=10
EMAIL_PROVIDER_IDEMPOTENCY_WINDOW_SECONDS=82800
RESEND_SUCCESS_RESPONSE_MAX_BODY_BYTES=65536
RESEND_ERROR_RESPONSE_MAX_BODY_BYTES=65536
RESEND_WEBHOOK_MAX_BODY_BYTES=262144
RESEND_WEBHOOK_TIMESTAMP_WINDOW_SECONDS=300
EMAIL_WEBHOOK_CORRELATION_TTL_SECONDS=604800
EMAIL_WEBHOOK_RETENTION_SECONDS=2592000
EMAIL_WEBHOOK_RECONCILIATION_BATCH_SIZE=100

# OAuth applications are configured only from environment-backed allauth APPS.
# Leave a provider pair empty locally to show that provider as unavailable.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SOCIALACCOUNT_REQUESTS_TIMEOUT=5

# Local-account credentials and distributed rate-limit keys are
# domain-separated from DJANGO_SECRET_KEY when these optional overrides are
# empty. Production role allowlists use that derivation so web never needs the
# Resend send key.
AUTH_CREDENTIAL_SIGNING_SECRET=
AUTH_RATE_LIMIT_SIGNING_SECRET=
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_API_MAX_BODY_BYTES=16384

# Database-backed, per-user fixed-window limits. One row is retained per
# user/scope rather than one row per request.
COMMENT_CREATE_RATE_LIMIT_COUNT=10
COMMENT_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
COMMENT_MUTATION_RATE_LIMIT_COUNT=30
COMMENT_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
REACTION_TOGGLE_RATE_LIMIT_COUNT=60
REACTION_TOGGLE_RATE_LIMIT_WINDOW_SECONDS=60

# Set only after this address has completed a verified Google/GitHub signup.
SITE_OWNER_EMAIL=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kirillwynn
POSTGRES_USER=kirillwynn
POSTGRES_PASSWORD=local-development-only
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=60

# Production-only S3-compatible uploaded media. Static files remain separate
# and are collected into the immutable Django image. Use different values for
# staging and production; never commit credentials.
S3_MEDIA_ACCESS_KEY_ID=
S3_MEDIA_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=
S3_MEDIA_ENDPOINT_URL=
S3_MEDIA_REGION=
S3_MEDIA_ADDRESSING_STYLE=virtual
S3_MEDIA_PUBLIC_ORIGIN=

# The production worker runs one scheduler per environment. Every task invokes
# an existing bounded management command and backs off independently.
WORKER_PUBLISH_INTERVAL_SECONDS=60
WORKER_REVALIDATION_INTERVAL_SECONDS=15
WORKER_EMAIL_INTERVAL_SECONDS=10
WORKER_AUTH_EMAIL_INTERVAL_SECONDS=10
WORKER_WEBHOOK_INTERVAL_SECONDS=60
WORKER_REVALIDATION_BATCH_SIZE=100
WORKER_EMAIL_OUTBOX_BATCH_SIZE=25
WORKER_EMAIL_DELIVERY_BATCH_SIZE=100
WORKER_AUTH_EMAIL_BATCH_SIZE=25
WORKER_WEBHOOK_BATCH_SIZE=100
