# Server-side Django origin for local, non-Compose development. Production
# rewrites use the environment-neutral http://django:8000 Compose alias.
# This value is never exposed to browser code.
DJANGO_API_URL=http://localhost:8000

# Browser OAuth/API requests use fixed same-origin rewrites. Never expose
# DJANGO_API_URL through a NEXT_PUBLIC_* variable.

# Public, non-secret canonical origin used by server-rendered metadata.
# Required in production; must not contain a path, query, or fragment.
# Server-runtime origin. It is deliberately not NEXT_PUBLIC_* and must not be
# supplied while building the promotable production image.
PUBLIC_SITE_URL=http://localhost:3000

# Must match Django REVALIDATION_SECRET and contain at least 32 UTF-8 bytes.
# Supply only through runtime environment.
REVALIDATION_SECRET=
REVALIDATION_TIMESTAMP_WINDOW_SECONDS=300

# Keep aligned with Django PREVIEW_TOKEN_TTL_SECONDS.
PREVIEW_TOKEN_TTL_SECONDS=600
