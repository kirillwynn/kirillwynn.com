{
  "name": "kirillwynn-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle-contract": "node ../../infra/tests/verify-reaction-picker-bundle.mjs .",
    "test:browser-contract": "playwright test --config=playwright.browser-contract.config.ts",
    "test:cross-stack": "playwright test --config=playwright.cross-stack.config.ts",
    "test:staging-audit": "playwright test --config=playwright.staging-audit.config.ts",
    "test:e2e": "npm run test:browser-contract && npm run test:cross-stack"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.4",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "prettier": "3.7.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "playwright-core": "1.62.0",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
