SERVICE_ROLE=worker
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-in-github-environment
PUBLIC_SITE_URL=https://staging.kirillwynn.com
REVALIDATION_URL=http://next:3000/api/revalidate
REVALIDATION_SECRET=replace-in-github-environment-at-least-32-bytes
SUBSCRIPTION_SIGNING_SECRET=replace-in-github-environment-at-least-32-bytes
POSTGRES_SSLMODE=disable
S3_MEDIA_ACCESS_KEY_ID=replace-in-github-environment
S3_MEDIA_SECRET_ACCESS_KEY=replace-in-github-environment
S3_MEDIA_BUCKET=kirillwynn-staging-media
S3_MEDIA_PREFIX=staging/media
S3_MEDIA_ENDPOINT_URL=https://s3.example.invalid
S3_MEDIA_REGION=us-west-1
S3_MEDIA_ADDRESSING_STYLE=virtual
S3_MEDIA_PUBLIC_ORIGIN=https://staging-media.example.invalid
EMAIL_PROVIDER_ADAPTER=apps.subscriptions.providers.resend.ResendEmailProvider
EMAIL_PROVIDER_IDEMPOTENCY_NAMESPACE=resend/staging/account
EMAIL_FROM_ADDRESS=Kirill Wynn Staging <posts@staging.example.invalid>
RESEND_API_KEY=replace-in-github-environment
RESEND_API_URL=https://api.resend.com/emails
WORKER_EGRESS_PROBE_URL=https://api.resend.com/
WORKER_PUBLISH_INTERVAL_SECONDS=60
WORKER_REVALIDATION_INTERVAL_SECONDS=15
WORKER_EMAIL_INTERVAL_SECONDS=10
WORKER_AUTH_EMAIL_INTERVAL_SECONDS=10
WORKER_WEBHOOK_INTERVAL_SECONDS=60
WORKER_REVALIDATION_BATCH_SIZE=100
WORKER_EMAIL_OUTBOX_BATCH_SIZE=25
WORKER_EMAIL_DELIVERY_BATCH_SIZE=100
WORKER_AUTH_EMAIL_BATCH_SIZE=25
WORKER_WEBHOOK_BATCH_SIZE=100
