SERVICE_ROLE=web
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=django sentinel $ ${UNCHANGED} # "quotes" 'single' \ backslash and spaces
DJANGO_ALLOWED_HOSTS=staging.test,django,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://staging.test:18080
WAGTAIL_ADMIN_BASE_URL=http://staging.test:18080/cms
PUBLIC_SITE_URL=http://staging.test:18080
FRONTEND_PREVIEW_URL=http://staging.test:18080/api/draft
REVALIDATION_URL=http://next:3000/api/revalidate
REVALIDATION_SECRET=revalidation sentinel $ ${UNCHANGED} # "quotes" 'single' \ backslash and spaces
SUBSCRIPTION_SIGNING_SECRET=subscription integration secret at least 32 bytes
POSTGRES_SSLMODE=disable
S3_MEDIA_ACCESS_KEY_ID=integration
S3_MEDIA_SECRET_ACCESS_KEY=s3-only-integration-secret
S3_MEDIA_BUCKET=kirillwynn-integration-media
S3_MEDIA_PREFIX=integration/media
S3_MEDIA_ENDPOINT_URL=http://minio:9000
S3_MEDIA_REGION=us-east-1
S3_MEDIA_ADDRESSING_STYLE=path
S3_MEDIA_PUBLIC_ORIGIN=http://127.0.0.1:19000
GOOGLE_OAUTH_CLIENT_ID=google-integration
GOOGLE_OAUTH_CLIENT_SECRET=google-only-integration-secret
GITHUB_OAUTH_CLIENT_ID=github-integration
GITHUB_OAUTH_CLIENT_SECRET=github-only-integration-secret
EMAIL_PROVIDER_ADAPTER=apps.subscriptions.providers.memory.MemoryEmailProvider
EMAIL_PROVIDER_IDEMPOTENCY_NAMESPACE=memory/integration
EMAIL_FROM_ADDRESS=Integration <integration@example.com>
RESEND_WEBHOOK_SECRET=resend-webhook-not-required-by-memory
